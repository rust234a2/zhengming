# 争鸣 · 服务端配置模板
#
# 用法：复制为 .env 并填入真实值。
#   cp .env.example .env
#
# .env 已被 .gitignore 忽略（规则：`.env`），**绝不入库**。

# 阶跃星辰 StepFun API key（Host 上游模型）
# 未配置时：服务端仍可启动，Host 自动降级为启发式，响应带 degraded:true。
# 申请地址：https://platform.stepfun.com/
STEPFUN_API_KEY=

# 服务端口（可选，默认 5300）
# PORT=5300

# 辩论间领域模块路径（可选）
# 默认读 web/dist-domain/domain/debateRoom.js（由 web/ 的 npm run build:domain 产出）
# ZHENGMING_DOMAIN=

# 指定其它 .env 文件位置（可选）
# ZHENGMING_ENV=
